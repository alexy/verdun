    "./domains/vercel": {
      "types": "./lib/src/domains/vercel.d.ts",
      "default": "./lib/src/domains/vercel.js"
    },
    "./api/public/http": {
      "types": "./lib/api/public/http.d.ts",
      "default": "./lib/api/public/http.js"
    },
    "./api/public/workbench-local-adapter": {
      "types": "./lib/api/public/workbench-local-adapter.d.ts",
      "default": "./lib/api/public/workbench-local-adapter.js"
    },
    "./db/public/account-migrations": "./db/public/account-migrations.mjs",
    "./db/public/workbench-migrations": "./db/public/workbench-migrations.mjs",
    "./frontend/workbench-style.css": "./frontend/workbench-style.css",
    "./frontend/workbench-ui": "./frontend/workbench-ui.ts",
    "./frontend/workbench-view": "./frontend/workbench-view.ts",
    "./scripts/public/check-deployed": "./scripts/public/check-deployed.mjs",
    "./scripts/public/database-reload-handoff": "./scripts/public/database-reload-handoff.mjs",
    "./scripts/public/deploy-workbench-database": "./scripts/public/deploy-workbench-database.mjs",
    "./scripts/public/deploy-profile-contract": "./scripts/public/deploy-profile-contract.mjs",
    "./scripts/public/test-loader": "./scripts/public/test-loader.mjs",
    "./scripts/public/workbench-apply-sql": "./scripts/public/workbench-apply-sql.mjs",
    "./scripts/public/workbench-api-modules": "./scripts/public/workbench-api-modules.mjs",
    "./email": {
      "types": "./lib/api/core/email.d.ts",
      "default": "./lib/api/core/email.js"
    },
    "./svix": {
      "types": "./lib/api/core/svix.d.ts",
      "default": "./lib/api/core/svix.js"
    },
    "./frontend/ontology-ui": "./frontend/ontology-ui.ts",
    "./frontend/ontology-view": "./frontend/ontology-view.ts"
  },
  "files": [
    "api",
    "db",
    "lib",
    "frontend",
    "scripts/core",
    "scripts/instances",
    "scripts/public",
    "scripts/check-deployed.mjs",
    "scripts/database-reload-handoff.mjs",
    "scripts/deploy-workbench-database.mjs",
    "scripts/workbench-apply-sql.mjs",
    "scripts/smoke-account-store.mjs",
    "scripts/smoke-email-auth.mjs",
    "scripts/smoke-email-auth-postgres.mjs",
    "scripts/smoke-generic-loader-sql.mjs",
    "scripts/smoke-plans.mjs",
    "scripts/smoke-vercel-domains.mjs",
    "src/accounts",
    "src/domains",
    "src/components/workbench",
    "src/composables",
    "src/core",
    "src/instances",
    "src/style.css",
    "PUBLIC_SURFACE.md",
    "EXTERNAL_APP.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "dev:app": "vite --host 127.0.0.1 --port 5176 --strictPort",
    "build": "vue-tsc -b && vite build",
    "build:package": "rm -rf lib && tsc -p tsconfig.package.json",
    "prepare": "npm run build:package",
    "preview": "vite preview",
    "vercel:config": "node scripts/generate-vercel-config.mjs",
    "smoke:vercel-config": "node scripts/generate-vercel-config.mjs --check",
    "prod:build": "vue-tsc -b && vite build --outDir dist-prod",
    "prod:app": "vite preview --host 127.0.0.1 --port 5174 --strictPort --outDir dist-prod",
    "check:deployed": "node scripts/check-deployed.mjs",
    "check:preview": "node scripts/check-preview.mjs",
    "db:apply": "node scripts/workbench-apply-sql.mjs",
    "db:deploy": "node scripts/deploy-workbench-database.mjs",
    "smoke:all": "node scripts/smoke-all.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "smoke:check-deployed": "node scripts/smoke-check-deployed-readiness.mjs",
    "smoke:public-surface": "node scripts/smoke-public-surface.mjs",
    "smoke:api-http": "node scripts/smoke-api-http.mjs",
    "smoke:crawler-instance": "node scripts/smoke-crawler-instance.mjs",
    "smoke:db-apply": "node scripts/smoke-db-apply.mjs",
    "smoke:db-deploy": "node scripts/smoke-db-deploy.mjs",
    "smoke:demo-workbench": "node scripts/smoke-demo-workbench.mjs",
    "smoke:generic-loader": "node scripts/smoke-generic-loader-sql.mjs",
    "smoke:account-store": "node scripts/smoke-account-store.mjs",
    "smoke:email-auth": "node scripts/smoke-email-auth.mjs",
    "smoke:email-auth-postgres": "node scripts/smoke-email-auth-postgres.mjs",
    "smoke:plans": "node scripts/smoke-plans.mjs",
    "smoke:vercel-domains": "node scripts/smoke-vercel-domains.mjs",
    "smoke:workbench": "node scripts/smoke-workbench-api.mjs",
    "smoke:ontology-conformance": "node scripts/smoke-ontology-conformance.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "@neondatabase/serverless": "^1.1.0"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@querygraph/ontology": "*"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "pg": "^8.22.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue": "3.5.38",
    "vue-tsc": "^3.2.8",
    "@querygraph/ontology": "github:querygraph/ontology#e0e641b050496b64e21c2b3fd67a4606232b88f3"
  },
  "peerDependenciesMeta": {
    "@querygraph/ontology": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  }
}
